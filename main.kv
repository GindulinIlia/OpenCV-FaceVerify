#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<DirectionButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: 0.173, 0.243, 0.314, 1
    color: 1, 1, 1, 1
    font_size: sp(17)
    bold: True
    size_hint_y: None
    height: dp(55)
    canvas.before:
        Color:
            rgba: self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10),]

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(15)

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(200)
            spacing: dp(10)
            padding: [0, dp(20), 0, 0]

            Image:
                source: 'images/logo-hq.png'
                allow_stretch: True
                keep_ratio: True
                size_hint_y: 0.75

            Label:
                text: 'Выберите направление подготовки'
                font_size: sp(20)
                bold: True
                color: 0.173, 0.243, 0.314, 1
                halign: 'center'
                valign: 'middle'
                text_size: self.width, None

        BoxLayout:
            orientation: 'vertical'
            spacing: dp(12)

            DirectionButton:
                text: 'Архитектура'
                on_release: root.go_to_direction('architecture', 1)

            DirectionButton:
                text: 'Дизайн'
                on_release: root.go_to_direction('design', 2)

            DirectionButton:
                text: 'Сервис'
                on_release: root.go_to_direction('service', 3)

            DirectionButton:
                text: 'Строительство'
                on_release: root.go_to_direction('construction', 4)

            DirectionButton:
                text: 'Прикладная информатика'
                on_release: root.go_to_direction('information', 5)

<ArchitectureScreen>:
    BoxLayout:
        orientation: 'vertical'

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(80)
            padding: [dp(15), 0, dp(15), 0]
            canvas.before:
                Color:
                    rgba: 0.173, 0.243, 0.314, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            Image:
                source: 'images/logo-hq.png'
                allow_stretch: True
                keep_ratio: True
                size_hint_x: None
                width: dp(60)

            Label:
                text: root.direction_name
                font_size: sp(22)
                bold: True
                color: 1, 1, 1, 1
                halign: 'center'
                valign: 'middle'
                text_size: self.width, None

        ScrollView:
            do_scroll_x: False

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(15)

                Label:
                    text: 'Архитектура'
                    font_size: sp(22)
                    bold: True
                    color: 0.173, 0.243, 0.314, 1
                    size_hint_y: None
                    height: dp(50)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, None

                BoxLayout:
                    id: table_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(5)

        BoxLayout:
            size_hint_y: None
            height: dp(70)
            padding: [dp(20), dp(10), dp(20), dp(10)]

            Button:
                text: 'Назад к направлениям'
                background_normal: ''
                background_down: ''
                background_color: 0.2, 0.6, 0.86, 1
                color: 1, 1, 1, 1
                font_size: sp(16)
                bold: True
                canvas.before:
                    Color:
                        rgba: self.background_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8),]
                on_release: root.go_back()

